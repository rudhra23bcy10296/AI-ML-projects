# =====================================================================
# RAG Chatbot Capstone Project - Environment Configuration Template
# Instructions: Copy this file to '.env' in the same directory and 
# paste your actual Groq API Key below.
# =====================================================================

# ---------------------------------------------------------------------
# Groq Cloud LLM API Configuration (REQUIRED)
# Obtain your free API key at: https://console.groq.com/keys
# ---------------------------------------------------------------------
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# ---------------------------------------------------------------------
# Groq LLM Model Selection
# Recommended options:
# - llama-3.1-8b-instant  (Fastest & Recommended)
# - llama3-70b-8192       (High accuracy for complex prompts)
# - mixtral-8x7b-32768    (Long-context processing)
# ---------------------------------------------------------------------
GROQ_MODEL=llama-3.1-8b-instant

# ---------------------------------------------------------------------
# VectorStore & FAQ Dataset Settings (Optional Defaults)
# ---------------------------------------------------------------------
# Path to the FAQ JSON dataset for RAG ingestion
DATASET_PATH=./data/university_faq.json

# Persistent ChromaDB vector database directory
DB_DIR=./chroma_db

# ChromaDB collection name
COLLECTION_NAME=faq_collection

# Custom Chatbot Domain Name (e.g., "Rivermount University", "Tech Support")
CHATBOT_DOMAIN=Rivermount University
